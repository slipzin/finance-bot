{
  "name": "smart-tv",
  "productName": "Smart TV",
  "version": "1.0.0",
  "description": "Launcher de Smart TV com apps nativos (janelas dedicadas, UI de TV, DRM Widevine)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "test": "node --test"
  },
  "author": "slipzin",
  "license": "MIT",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.slipzin.smarttv",
    "productName": "Smart TV",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "files": [
      "src/**/*",
      "apps.json",
      "icons/**/*",
      "scripts/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": "nsis"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
